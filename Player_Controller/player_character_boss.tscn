[sub_resource type="GDScript" id="GDScript_ifhgq"]
script/source = "# This line tells the Boss Script to read the main player logic
extends \"res://Player_Controller/scripts/Player_Character/player_character.gd\"

func _ready() -> void:
	# Basic setup from main script
	update_camera_rotation()
	calculate_movement_parameters()
	
	if raycast:
		raycast.add_exception(self)
	
	# Boss Level Specific Logic
	print(\"SYSTEM: Boss Level - Movement enabled instantly.\")
	if dialog_label:
		dialog_label.text = \"Are you ready?\"
	
	can_move = true # Instant movement for the boss level
"

